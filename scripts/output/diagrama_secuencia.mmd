sequenceDiagram
    autonumber
    actor Usuario as Usuario
    participant Frontend as Frontend (Next.js)
    participant Backend as Backend (Flask)
    participant Worker as Celery Worker
    participant ES as EvaluationService
    participant MinIO as MinIO (S3)
    participant DB as PostgreSQL

    Usuario->>Frontend: Inicia análisis
    Frontend->>Backend: POST /api/evaluations/projects/{project_id}/analyze
    activate Backend
    Backend->>DB: Crea AnalysisRun (PENDING) + Evaluation legacy
    Backend->>Worker: Encola tarea Celery (run_evaluation)
    Backend-->>Frontend: 202 Accepted {analysis_run_id}
    deactivate Backend

    loop Polling (cada pocos segundos)
        Frontend->>Backend: GET /api/evaluations/analysis/{run_id}/status
        Backend->>DB: Consulta estado
        DB-->>Backend: Retorna estado
        Backend-->>Frontend: Retorna estado (PENDING/RUNNING)
    end

    activate Worker
    Worker->>DB: Actualiza AnalysisRun (RUNNING)
    Worker->>ES: run_evaluation(evaluation_id, analysis_run_id)
    activate ES
    ES->>MinIO: download_file(dataset)
    MinIO-->>ES: Datos del dataset (CSV)
    ES->>ES: Ejecuta métricas configuradas (genera fingerprints)
    ES->>ES: Calcula Quality Score
    ES->>ES: Evalúa Quality Gate
    ES->>DB: Persiste issues y compara con baseline (nuevos/recurrentes)
    ES->>DB: Actualiza AnalysisRun (COMPLETED)
    ES-->>Worker: Retorna resultado (dict)
    deactivate ES
    Worker->>DB: Marca Evaluation legacy (COMPLETED)
    deactivate Worker

    Frontend->>Backend: GET /api/evaluations/analysis/{run_id}/status
    Backend->>DB: Consulta estado
    DB-->>Backend: Retorna COMPLETED
    Backend-->>Frontend: Retorna estado (COMPLETED)
    Frontend->>Usuario: Redirige a página de resultados
