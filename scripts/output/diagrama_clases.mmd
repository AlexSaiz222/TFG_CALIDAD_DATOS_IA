classDiagram
    direction TB

    namespace Services {
        class EvaluationService {
            +run_evaluation(evaluation_id, analysis_run_id)
        }
        class DatasetService {
            +process_dataset(file_obj, project_id)
            +analyze_dataset(file_path)
            +get_dataset_columns(file_path)
        }
        class MinioService {
            +upload_file(file_obj)
            +download_file(object_name)
            +get_presigned_url(object_name)
        }
    }

    namespace MetricsEngine {
        class BaseMetric {
            <<abstract>>
            +String log_prefix
            +evaluate(df, parameters, dataset, evaluation_id, metrics_map)*
            +calculate_dynamic_severity()$
            +infer_column_type()$
            +mask_sensitive()$
            +generate_histogram()$
            +apply_null_patterns()$
        }
        class MetricResult {
            <<dataclass>>
            +String metric_id
            +Optional~float~ score
            +dict results
            +list issues
        }
        class CompletenessMetric
        class UniquenessMetric
        class SyntacticAccuracyMetric
        class LogicalConsistencyMetric
        class ClassBalanceMetric
        class CurrentnessMetric
        class DiversityMetric
        class OutliersMetric
    }

    BaseMetric <|-- CompletenessMetric
    BaseMetric <|-- UniquenessMetric
    BaseMetric <|-- SyntacticAccuracyMetric
    BaseMetric <|-- LogicalConsistencyMetric
    BaseMetric <|-- ClassBalanceMetric
    BaseMetric <|-- CurrentnessMetric
    BaseMetric <|-- DiversityMetric
    BaseMetric <|-- OutliersMetric
    note for OutliersMetric "No se registra en METRIC_REGISTRY (uso exclusivo del módulo de perfilado EDA)"

    BaseMetric ..> MetricResult : produce
    EvaluationService ..> BaseMetric : ejecuta
    EvaluationService ..> MetricResult : agrega
    EvaluationService ..> MinioService : usa
    DatasetService ..> MinioService : usa
