graph TB
    subgraph Frontend ["Presentación - Frontend (React + Next.js)"]
        components[components]
        pages[pages]
        front_services[services]
        contexts[contexts]
    end

    subgraph Backend ["Backend (Flask)"]
        api["api - API REST (10 blueprints)"]
        services["services - Servicios (lógica)"]
        metrics["services.metrics - Motor de métricas"]
        models["models - Datos (ORM SQLAlchemy)"]
    end

    subgraph Infra ["Infraestructura externa (Docker Compose)"]
        postgres[(PostgreSQL)]
        minio[(MinIO)]
        redis[(Redis)]
        celery["Celery Worker / Beat"]
        flower["Flower"]
    end

    front_services -.->|HTTP/JSON| api
    api -.-> services
    services -.-> metrics
    services -.-> models
    metrics -.-> models
    models -.-> postgres
    services -.-> minio
    celery -.->|tareas asíncronas| services
    celery -.-> redis
    flower -.->|monitoriza| celery
