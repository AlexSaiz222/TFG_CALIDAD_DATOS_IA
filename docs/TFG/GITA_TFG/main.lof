\contentsline {figure}{\numberline {5.1}{\ignorespaces Burndown global del proyecto: \emph {story points} restantes por sprint (línea ideal vs.\ progreso real)}}{45}{figure.5.1}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Arquitectura lógica por capas de \textsc {DataQual}\xspace en su estado final (cierre del Sprint~5), mostrando las dependencias \emph {depends-on} (flecha discontinua de punta abierta). El directorio \texttt {services/metrics/} ($\star $) constituye el núcleo extensible del motor de evaluación, alineado con el principio abierto--cerrado~\citep {design_patterns}}}{48}{figure.5.2}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Cuadro de mando principal de \textsc {DataQual}\xspace : tarjetas resumen de proyectos, distribución de estados de \emph {Quality Gate} y alertas de proyectos con problemas detectados}}{60}{figure.5.3}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Página de resultados de evaluación: indicador circular de puntuación de calidad (\emph {gauge}), tabla de métricas por columna y listado de \emph {issues} con severidad y columna afectada}}{60}{figure.5.4}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Módulo de exploración de datos (\acs {EDA}): histogramas de distribución, diagramas de caja y matriz de correlación Pearson/Spearman para columnas numéricas}}{60}{figure.5.5}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces \emph {Quality Gate} de \textsc {DataQual}\xspace : estado global con código de color (PASSED/WARNING/FAILED), desglose de condiciones configuradas y \emph {badges} de trazabilidad de \emph {issues} por \emph {fingerprinting}}}{64}{figure.5.6}%
