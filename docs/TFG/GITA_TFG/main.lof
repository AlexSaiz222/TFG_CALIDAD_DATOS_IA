\contentsline {figure}{\numberline {5.4}{\ignorespaces Canvas de árbol de versiones (\emph {Visual version tree}): grafo interactivo con nodos coloreados por estado de \emph {Quality Gate} y diferencial de puntuación entre versiones padre-hijo}}{55}{figure.5.4}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Comparación entre versiones de un \emph {dataset}: \emph {issues} resueltos, nuevos y persistentes entre dos versiones seleccionadas, con detalle de descripción y columna afectada}}{56}{figure.5.5}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Diálogo de configuración detallada de la métrica \emph {Uniqueness}: umbral de unicidad mínimo, selección de columnas que deben ser únicas y previsualización del \acs {JSON} de parámetros generado}}{61}{figure.5.6}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Cuadro de mando principal de \textsc {DataQual}\xspace : tarjetas resumen de proyectos, distribución de estados de \emph {Quality Gate} y alertas de proyectos con problemas detectados}}{64}{figure.5.7}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Historial de análisis de un proyecto: evolución temporal de la puntuación de calidad, tendencia por \emph {dataset} y tabla de ejecuciones con estado de \emph {Quality Gate}}}{65}{figure.5.8}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Página de resultados de evaluación: puntuación de calidad global, resumen de métricas por dimensión, listado de \emph {issues} con severidad y columna afectada, y cálculo detallado de la puntuación final}}{66}{figure.5.9}%
