%% -- Caja de Objetivo General/Específico
\newtcolorbox{objbox}[2][]{%
  enhanced,
  colback=gray95,
  colframe=black!75,
  arc=2pt,
  boxrule=0.6pt,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  fonttitle=\bfseries\sffamily,
  coltitle=white,
  colbacktitle=black!75,
  title={#2},
  #1
}

%% -- Completar jerarquía de títulos sans-serif (gita-tfg.cls solo define
%%    \titleformat hasta \subsection; \subsubsection y \paragraph heredan
%%    el defecto de book, que es Times bold y rompe la coherencia visual)
\titleformat{\subsubsection}
  {\normalfont\sffamily\bfseries\fontsize{12pt}{1em}\selectfont}
  {\thesubsubsection}{1em}{}
\titlespacing{\subsubsection}{0pt}{3mm}{-1mm}

\titleformat{\paragraph}[runin]
  {\normalfont\sffamily\bfseries\normalsize}{\theparagraph}{1em}{}

\definecolor{deepskyblue}{rgb}{0.0, 0.75, 1.0}
\definecolor{gray95}{gray}{0.95}
\definecolor{codegreen}{rgb}{0.0, 0.5, 0.0}
\definecolor{codegray}{rgb}{0.5, 0.5, 0.5}
\definecolor{codepurple}{rgb}{0.58, 0.0, 0.82}
\definecolor{backcolour}{rgb}{0.97, 0.97, 0.97}
\definecolor{passedgreen}{rgb}{0.18, 0.54, 0.34}
\definecolor{warningyellow}{rgb}{0.85, 0.65, 0.13}
\definecolor{failedred}{rgb}{0.70, 0.13, 0.13}

% Configuración de listados de código
\lstset{%
  backgroundcolor  = \color{backcolour},
  commentstyle     = \color{codegreen},
  keywordstyle     = \color{codepurple}\bfseries,
  stringstyle      = \color{deepskyblue},
  numberstyle      = \tiny\color{codegray},
  basicstyle       = \ttfamily\footnotesize,
  breaklines       = true,
  breakatwhitespace= false,
  numbers          = left,
  numbersep        = 5pt,
  showspaces       = false,
  showstringspaces = false,
  showtabs         = false,
  tabsize          = 4,
  frame            = single,
  rulecolor        = \color{codegray},
  captionpos       = b,
}

\lstloadlanguages{Python, Java, XML}
\lstdefinelanguage{JavaScript}{
  keywords={break, case, catch, const, continue, debugger, default, delete,
    do, else, export, extends, finally, for, function, if, import, in,
    instanceof, let, new, return, super, switch, this, throw, try, typeof,
    var, void, while, with, yield, async, await, class, enum, implements,
    interface, package, private, protected, public, static},
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]',
  morestring=[b]",
  morestring=[b]`,
  sensitive=true
}
\lstdefinelanguage{TypeScript}[]{JavaScript}{
  morekeywords={type, namespace, declare, module, abstract, as, asserts,
    any, boolean, bigint, never, number, object, string, symbol, undefined,
    unknown, void, keyof, readonly, unique, infer, is}
}

\def\gitatfg{\emph{gita-tfg}\xspace}
\def\texcmd#1{\texttt{$\backslash$#1}}
