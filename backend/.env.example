# Plantilla de variables de entorno del backend.
# Copiar a `backend/.env` y ajustar los valores.
# IMPORTANTE: cambiar SECRET_KEY y JWT_SECRET_KEY por valores aleatorios
# antes de cualquier despliegue que no sea de desarrollo local.

# Configuración de la aplicación
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# Base de datos
# En docker-compose el host es el nombre del servicio (postgres).
# Para ejecución local fuera de Docker, usar localhost.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/dataquality

# JWT
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# MinIO (almacenamiento de objetos compatible con S3)
MINIO_URL=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET=datasets

# Redis (broker de Celery y caché)
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://redis:6379/1
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_STRATEGY=fixed-window
